name:           HaskellTemplate
version:        0.1.0.0
description:    Please see the README on GitHub at <https://github.com/githubuser/HaskellTemplate#readme>
homepage:       https://github.com/githubuser/HaskellTemplate#readme
bug-reports:    https://github.com/githubuser/HaskellTemplate/issues
author:         James Test
maintainer:     james@test.com
copyright:      School of Haskell in Luebeck
license:        BSD3
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    ChangeLog.md

source-repository head
  type: git
  location: https://github.com/githubuser/HaskellTemplate

library
  exposed-modules:
      Functions.Composition
      Functions.Functions
      Functions.Operators
      Lists.Comprehension
      Lists.ConcatMap
      Lists.Foldl
      Lists.Foldr
      Lists.MapFilter
      Lists.Recursion
      ListsFak.ListMonad
      ListsFak.MoreFun
  hs-source-dirs:
      src
  build-depends:
      QuickCheck
    , base >=4.7 && <5
  default-language: Haskell2010

executable HaskellTemplate
  main-is: Main.hs
  hs-source-dirs:
      app
  ghc-options: -threaded -rtsopts -with-rtsopts=-N -main-is Main.main
  build-depends:
      HaskellTemplate
    , QuickCheck
    , base >=4.7 && <5
  default-language: Haskell2010

